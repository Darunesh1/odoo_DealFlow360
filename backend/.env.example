# Project Name (used to customize Docker container names)
PROJECT_NAME=dealflow

# Environment Type (development, production, testing)
ENVIRONMENT=development

# Public URL of the frontend. Links inside emails point here.
FRONTEND_URL=http://localhost:5173

# Comma separated list of browser origins allowed to call this API
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# PostgreSQL settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=backend_db

# Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379

# Security/JWT settings
# Generate a secret key using: openssl rand -hex 32
# The value below is refused when ENVIRONMENT=production.
JWT_SECRET_KEY=supersecretkeychangeinproduction123
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Single use email token lifetimes
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30

# Email/SMTP settings (used by the Celery task that dispatches mail)
# While all four SMTP_* values are unset, emails are printed to the worker log
# instead of being sent, so you can copy a verification link out of the terminal.
# Fill all four in to send real mail.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=your_email@gmail.com
#SMTP_PASSWORD=your_app_password
EMAILS_FROM_EMAIL=no-reply@yourdomain.com
EMAILS_FROM_NAME=DealFlow360
