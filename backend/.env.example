# Project Name (used to customize Docker container names)
PROJECT_NAME=dealflow

# Environment Type (development, production, testing)
ENVIRONMENT=development

# Public URL of the frontend. Links inside emails point here.
FRONTEND_URL=http://localhost:5173

# Comma separated list of browser origins allowed to call this API
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# PostgreSQL settings
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=backend_db

# Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379

# Security/JWT settings
# Generate a secret key using: openssl rand -hex 32
# The value below is refused when ENVIRONMENT=production.
JWT_SECRET_KEY=supersecretkeychangeinproduction123
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Single use email token lifetimes
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30

# Invitation link lifetime (admins create users, invitees set their own password)
INVITE_EXPIRE_HOURS=72

# Bootstrap administrator, created on startup when missing.
# There is no public signup, so without this nobody could sign in.
FIRST_ADMIN_EMAIL=admin@dealflow360.com
FIRST_ADMIN_PASSWORD=admin12345

# Also seed one demo account per role (rep@, manager@, finance@, customer@).
# Ignored unless ENVIRONMENT=development.
SEED_DEMO_USERS=true

# Email/SMTP settings (used by the Celery task that dispatches mail)
#
# While any of the four SMTP_* values is unset, emails are printed to the
# `make worker` log instead of being sent, so you can copy a verification link
# out of the terminal. Fill all four in and mail goes out for real - there is
# no other switch to flip.
#
# Gmail, with 2-Step Verification on:
#   1. myaccount.google.com -> Security -> 2-Step Verification -> App passwords
#   2. Generate one for "Mail"; you get 16 characters. Paste them below with or
#      without the spaces - your ordinary account password will NOT work.
#   3. EMAILS_FROM_EMAIL must be the SAME address as SMTP_USER. Gmail rewrites
#      or rejects a From it does not own, which looks exactly like mail that
#      silently never arrived.
#
# Port 587 is STARTTLS (SMTP_TLS=true, the default). For an implicit-TLS
# provider on port 465, set SMTP_PORT=465 and SMTP_SSL=true instead.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=your_email@gmail.com
#SMTP_PASSWORD=your_16_char_app_password
#SMTP_TLS=true
#SMTP_SSL=false
EMAILS_FROM_EMAIL=no-reply@yourdomain.com
EMAILS_FROM_NAME=DealFlow360
